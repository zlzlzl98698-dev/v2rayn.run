---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  pubDate?: Date | string;
  cover?: string;
  author?: string;
  tag?: string;
}

const {
  title,
  description,
  href,
  category,
  pubDate,
  cover = '/images/covers/default.svg',
  author = 'v2rayn指南主编推荐',
  tag = '精选置顶',
} = Astro.props;

const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
  : '2026-10-19';
---

<article class="bg-white rounded-3xl border border-surface-border overflow-hidden card-hover-effect grid grid-cols-1 lg:grid-cols-12 shadow-sm group">
  <!-- Left/Top: Big Visual Cover -->
  <a href={href} class="relative lg:col-span-7 aspect-[16/10] overflow-hidden bg-slate-900 block">
    <img
      src={cover}
      alt={title}
      width="800"
      height="450"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent lg:hidden"></div>
    <span class="absolute top-4 left-4 bg-brand-600 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-md tracking-wider">
      {tag}
    </span>
  </a>

  <!-- Right/Bottom: Editorial Content -->
  <div class="p-6 sm:p-8 lg:p-10 lg:col-span-5 flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md">
          {category}
        </span>
        <span class="text-xs text-slate-400">·</span>
        <span class="text-xs text-slate-400">{formattedDate}</span>
      </div>

      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 group-hover:text-brand-600 transition-colors leading-tight">
        <a href={href}>{title}</a>
      </h2>

      <p class="text-slate-600 mt-4 text-base leading-relaxed line-clamp-3 sm:line-clamp-4">
        {description}
      </p>
    </div>

    <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img
          src="/images/avatar.webp?v=2"
          alt={author}
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
          class="w-8 h-8 rounded-full object-cover border border-brand-200"
        />
        <div>
          <p class="text-xs font-bold text-slate-900">{author}</p>
          <p class="text-[11px] text-slate-400">客观实验室核验</p>
        </div>
      </div>

      <a
        href={href}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-600 text-white font-semibold text-sm hover:bg-brand-700 transition-colors shadow-sm shadow-brand-500/20"
      >
        <span>深度阅读</span>
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </div>
</article>
