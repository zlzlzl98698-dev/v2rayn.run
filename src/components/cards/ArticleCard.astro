---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  pubDate?: Date | string;
  cover?: string;
  author?: string;
  readTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  href,
  category,
  pubDate,
  cover = '/images/covers/default.svg',
  author = 'v2rayn指南编辑部',
  readTime = '6 分钟',
  tags = [],
} = Astro.props;

const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
  : '2026-10-19';

const categoryMap: Record<string, string> = {
  airport: '机场推荐',
  vpn: 'VPN与加速器',
  clash: 'Clash客户端',
  resources: '资源与情报',
  reviews: '深度评测',
  guides: '实战教程',
  comparisons: '横向对比',
};

const displayCategory = categoryMap[category] || category;
---

<article class="bg-white rounded-2xl border border-surface-border overflow-hidden card-hover-effect flex flex-col h-full group">
  <!-- Card Image -->
  <a href={href} class="relative block aspect-[16/9] overflow-hidden bg-slate-100">
    <img
      src={cover}
      alt={title}
      width="800"
      height="450"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
    />
    <span class="absolute top-3 left-3 bg-brand-600/90 backdrop-blur-sm text-white text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm">
      {displayCategory}
    </span>
  </a>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Tags -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-2.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="text-[11px] font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Title -->
      <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors line-clamp-2 leading-snug">
        <a href={href}>
          {title}
        </a>
      </h3>

      <!-- Description -->
      <p class="text-sm text-slate-500 mt-2.5 line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Meta / Footer -->
    <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span>{author}</span>
        <span>·</span>
        <span>{formattedDate}</span>
      </div>
      <div class="flex items-center gap-1 text-brand-600 font-semibold group-hover:translate-x-0.5 transition-transform">
        <span>阅读</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
        </svg>
      </div>
    </div>
  </div>
</article>
