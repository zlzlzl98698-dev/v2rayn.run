---
interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  count?: number;
}

const { title, description, href, badge, count } = Astro.props;
---

<a
  href={href}
  class="bg-white rounded-2xl border border-surface-border p-5 sm:p-6 card-hover-effect flex flex-col justify-between group h-full"
>
  <div>
    <div class="flex items-center justify-between mb-3">
      <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-sm group-hover:bg-brand-600 group-hover:text-white transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      {badge && (
        <span class="text-[11px] font-semibold text-brand-700 bg-brand-50 px-2.5 py-0.5 rounded-full">
          {badge}
        </span>
      )}
    </div>

    <h3 class="text-lg font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-2">
      {title}
    </h3>
    <p class="text-xs sm:text-sm text-slate-500 line-clamp-2 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-brand-600 font-semibold">
    <span>进入专题指南</span>
    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
    </svg>
  </div>
</a>
