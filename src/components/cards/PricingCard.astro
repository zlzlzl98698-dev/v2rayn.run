---
import type { BrandPlan } from '../../types/brand';

interface Props {
  plan: BrandPlan;
  isPopular?: boolean;
  affUrl?: string;
}

const { plan, isPopular = false, affUrl = '#' } = Astro.props;
---

<div class={`rounded-2xl border p-6 flex flex-col justify-between h-full relative transition-all ${
  isPopular
    ? 'border-brand-500 bg-white shadow-lg shadow-brand-500/10 ring-2 ring-brand-500/20'
    : 'border-surface-border bg-white shadow-sm'
}`}>
  {isPopular && (
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-600 text-white text-[11px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider">
      热销推荐
    </div>
  )}

  <div>
    <div class="flex items-center justify-between gap-2 mb-2">
      <h4 class="text-base font-bold text-slate-900">{plan.name}</h4>
      <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md">
        {plan.billing}
      </span>
    </div>

    <div class="my-4">
      <span class="text-3xl font-black text-slate-900">{plan.price}</span>
      <span class="text-xs text-slate-400 font-medium ml-1">/ {plan.period}</span>
    </div>

    <div class="p-3 bg-slate-50 rounded-xl mb-4 text-xs space-y-1.5">
      <div class="flex items-center justify-between">
        <span class="text-slate-500">流量额度</span>
        <span class="font-bold text-slate-800">{plan.traffic}</span>
      </div>
      {plan.notes && (
        <div class="text-slate-500 pt-1 border-t border-slate-200/60 leading-relaxed">
          {plan.notes}
        </div>
      )}
    </div>
  </div>

  <div class="pt-4 border-t border-slate-100">
    <a
      href={affUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class={`block w-full text-center py-2.5 rounded-xl font-semibold text-xs transition-colors ${
        isPopular
          ? 'bg-brand-600 hover:bg-brand-700 text-white shadow-sm'
          : 'bg-slate-100 hover:bg-brand-50 text-slate-800 hover:text-brand-600'
      }`}
    >
      选择此方案
    </a>
  </div>
</div>
