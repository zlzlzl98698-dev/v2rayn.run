---
import { siteVerification } from '../../data/siteVerification';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  category?: string;
  tags?: string[];
  schema?: Record<string, any>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image = '/images/covers/default.svg',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'v2rayn指南测评实验室',
  category,
  tags,
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://v2rayn.run';
const currentUrl = canonical || (Astro.url.pathname ? `${siteUrl}${Astro.url.pathname}` : siteUrl);
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Default WebSite & Organization JSON-LD
const defaultSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'v2rayn指南',
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      description: '客观实测 · 拒绝虚标 · 中文网络工具与机场评测知识库',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'v2rayn指南',
      publisher: { '@id': `${siteUrl}/#organization` },
      inLanguage: 'zh-CN',
    },
    ...(schema ? [schema] : []),
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={currentUrl} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=2" />
<link rel="icon" type="image/webp" href="/favicon.webp?v=2" />
<link rel="shortcut icon" href="/favicon.ico?v=2" />
<link rel="apple-touch-icon" href="/favicon.webp?v=2" />

{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Search Engine Webmaster Ownership Verification (Pre-allocated Static Meta) -->
{siteVerification.google && <meta name="google-site-verification" content={siteVerification.google} />}
{siteVerification.bing && <meta name="msvalidate.01" content={siteVerification.bing} />}
{siteVerification.shenma && <meta name="shenma-site-verification" content={siteVerification.shenma} />}
{siteVerification.baidu && <meta name="baidu-site-verification" content={siteVerification.baidu} />}
{siteVerification.sogou && <meta name="sogou_site_verification" content={siteVerification.sogou} />}
{siteVerification.qihu360 && <meta name="360-site-verification" content={siteVerification.qihu360} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:site_name" content="v2rayn指南" />
<meta property="og:locale" content="zh_CN" />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}
{category && <meta property="article:section" content={category} />}
{tags && tags.map((t) => <meta property="article:tag" content={t} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(defaultSchema)} />
