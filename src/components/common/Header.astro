---
import { navigationData, siteMeta } from '../../data/navigation';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-surface-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-600 rounded-lg p-1">
          <img
            src="/images/avatar.webp?v=2"
            alt={siteMeta.name}
            width="40"
            height="40"
            class="w-10 h-10 rounded-xl object-cover shadow-sm shadow-brand-500/20 group-hover:scale-105 transition-transform border border-slate-200/80"
          />
          <div class="flex flex-col">
            <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">
              {siteMeta.name}
            </span>
            <span class="text-xs text-slate-500 font-medium -mt-1 hidden sm:block">
              客观实测 · 科学指南
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {navigationData.map((nav) => {
          const isActive = currentPath.startsWith(nav.href);
          return (
            <div class="relative group">
              <a
                href={nav.href}
                class={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-[15px] font-semibold transition-colors ${
                  isActive
                    ? 'text-brand-600 bg-brand-50/80'
                    : 'text-slate-700 hover:text-brand-600 hover:bg-slate-50'
                }`}
              >
                <span>{nav.title}</span>
                <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>

              <!-- Dropdown Menu -->
              <div class="absolute left-0 mt-1 w-72 bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top -translate-y-2 group-hover:translate-y-0 p-2 z-50">
                <div class="px-3 py-2 border-b border-slate-100 mb-1">
                  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{nav.title} 专题精选</p>
                </div>
                <div class="space-y-1">
                  {nav.items.map((item) => (
                    <a
                      href={item.href}
                      class="flex flex-col px-3 py-2 rounded-xl text-slate-700 hover:text-brand-600 hover:bg-brand-50/60 transition-colors group/item"
                    >
                      <span class="text-sm font-medium group-hover/item:text-brand-600">{item.title}</span>
                      <span class="text-xs text-slate-400 line-clamp-1 mt-0.5">{item.description}</span>
                    </a>
                  ))}
                </div>
                <div class="mt-2 pt-2 border-t border-slate-100 px-3 py-1.5 bg-slate-50 rounded-b-xl">
                  <a href={nav.href} class="text-xs font-semibold text-brand-600 hover:text-brand-700 flex items-center justify-between">
                    <span>浏览全部 {nav.title} 内容</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}

        <!-- Brand Database Link -->
        <a
          href="/brands/"
          class={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-[15px] font-semibold transition-colors ${
            currentPath.startsWith('/brands/')
              ? 'text-brand-600 bg-brand-50/80'
              : 'text-slate-700 hover:text-brand-600 hover:bg-slate-50'
          }`}
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-600"></span>
          </span>
          <span>品牌数据库</span>
        </a>
      </nav>

      <!-- Right Actions: Search & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <!-- Search Trigger Button -->
        <a
          href="/search/"
          class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200/80 text-slate-600 hover:text-brand-600 text-sm font-medium transition-colors border border-slate-200/70"
          aria-label="站内全文搜索"
        >
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span class="hidden md:inline text-xs text-slate-500">搜索文章、品牌与教程...</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-xl text-slate-600 hover:text-brand-600 hover:bg-slate-100 focus:outline-none"
          aria-label="切换移动端导航"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 max-h-[85vh] overflow-y-auto">
    <div class="space-y-4">
      <div class="pt-2 pb-1">
        <a href="/brands/" class="flex items-center justify-between p-3 rounded-xl bg-brand-50 text-brand-700 font-semibold text-sm">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-600"></span>
            31家机场品牌数据库（筛选与评测）
          </span>
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        </a>
      </div>

      {navigationData.map((nav) => (
        <div class="border-b border-slate-100 pb-3">
          <div class="flex items-center justify-between py-2">
            <a href={nav.href} class="text-base font-bold text-slate-900 hover:text-brand-600">
              {nav.title}
            </a>
            <a href={nav.href} class="text-xs font-semibold text-brand-600">进入主页 &rarr;</a>
          </div>
          <div class="grid grid-cols-2 gap-2 mt-2">
            {nav.items.map((item) => (
              <a
                href={item.href}
                class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-brand-600 hover:bg-slate-50 bg-slate-50/50"
              >
                {item.title}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });

    // Automatically close mobile menu if resized to desktop view
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
