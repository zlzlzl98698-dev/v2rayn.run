---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FAQItem[];
  headingLevel?: 'h2' | 'h3';
}

const { title = '常见问题解答 (FAQ)', items = [], headingLevel = 'h3' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: it.answer,
    },
  })),
};
---

{items.length > 0 && (
  <section class="my-10 pt-6 border-t border-slate-200">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    {headingLevel === 'h2' ? (
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-6 flex items-center gap-2">
        <span class="w-1.5 h-6 rounded-full bg-brand-600"></span>
        {title}
      </h2>
    ) : (
      <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="w-1.5 h-5 rounded-full bg-brand-600"></span>
        {title}
      </h3>
    )}

    <div class="space-y-4">
      {items.map((item, idx) => (
        <details class="group bg-white rounded-2xl border border-surface-border p-5 transition-all open:ring-1 open:ring-brand-500/20">
          <summary class="flex items-center justify-between font-bold text-slate-900 text-base cursor-pointer list-none select-none">
            <span class="pr-4">{item.question}</span>
            <span class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 group-open:rotate-180 group-open:bg-brand-50 group-open:text-brand-600 transition-transform">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 pt-3 border-t border-slate-100 text-sm text-slate-600 leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
