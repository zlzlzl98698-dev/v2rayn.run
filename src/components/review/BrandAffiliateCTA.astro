---
import type { Brand } from '../../types/brand';

interface Props {
  brand: Brand;
  customText?: string;
}

const { brand, customText } = Astro.props;
---

<div class="my-8 p-6 rounded-2xl bg-gradient-to-br from-brand-50 to-blue-50/40 border border-brand-100 shadow-sm">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-900 text-lg">{brand.name} 官方通道</span>
        {brand.couponCode && (
          <span class="text-xs bg-brand-100 text-brand-800 font-semibold px-2 py-0.5 rounded border border-brand-200">
            优惠码: <code>{brand.couponCode}</code>
          </span>
        )}
      </div>
      <p class="text-xs sm:text-sm text-slate-600">
        {customText || `${brand.startingPrice} 起 · ${brand.lineType} · ${brand.tagline}`}
      </p>
    </div>

    <a
      href={brand.affUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm transition-all shadow-md shadow-brand-500/25 whitespace-nowrap self-stretch sm:self-auto text-center"
    >
      <span>前往 {brand.name} 官网</span>
      <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </a>
  </div>

  <div class="mt-4 pt-3 border-t border-brand-100/80 flex items-center justify-between text-[11px] text-slate-400">
    <span>含推广链接，注册可能为本站带来维护佣金，绝不影响您的实付价格</span>
    <a href={`/brands/${brand.slug}/`} class="text-brand-600 hover:underline font-medium">查看详细评测报告 &rarr;</a>
  </div>
</div>
