---
import type { StreamingStatus } from '../../types/brand';

interface Props {
  brandName: string;
  streaming: StreamingStatus;
  testNode?: string;
}

const { brandName, streaming, testNode = '香港 / 日本 核心专线' } = Astro.props;

const items = [
  { key: 'chatgpt', name: 'ChatGPT', type: 'AI 工具', status: streaming.chatgpt, desc: streaming.chatgpt === 'supported' ? '原生IP全功能支持' : streaming.chatgpt === 'partial' ? '视节点而定需切点' : '存在地区风控' },
  { key: 'claude', name: 'Claude', type: 'AI 工具', status: streaming.claude, desc: streaming.claude === 'supported' ? '低降级率连通' : '存在限制' },
  { key: 'gemini', name: 'Gemini', type: 'AI 工具', status: streaming.gemini, desc: streaming.gemini === 'supported' ? '原生解锁可用' : streaming.gemini === 'partial' ? '部分节点受限' : '未测试' },
  { key: 'netflix', name: 'Netflix', type: '流媒体', status: streaming.netflix, desc: streaming.netflix === 'supported' ? '非自制剧全解锁' : '仅自制剧' },
  { key: 'disney', name: 'Disney+', type: '流媒体', status: streaming.disney, desc: streaming.disney === 'supported' ? '全区秒开支持' : '不支持' },
  { key: 'youtube', name: 'YouTube 4K', type: '流媒体', status: streaming.youtube, desc: streaming.youtube === 'supported' ? '原生优质缓存' : '支持' },
  { key: 'hbo', name: 'HBO Max', type: '流媒体', status: streaming.hbo, desc: streaming.hbo === 'supported' ? '美区原生解锁' : streaming.hbo === 'partial' ? '部分节点' : '未适配' },
  { key: 'tiktok', name: 'TikTok', type: '社交/直播', status: streaming.tiktok, desc: streaming.tiktok === 'supported' ? '无黑屏无拔卡' : '支持' },
  { key: 'spotify', name: 'Spotify', type: '音频流', status: streaming.spotify, desc: streaming.spotify === 'supported' ? '全区无阻碍' : '支持' },
];

const statusBadge = (s: string) => {
  if (s === 'supported') return { text: 'SUPPORTED', bg: 'bg-emerald-950 text-emerald-400 border-emerald-800', dot: 'bg-emerald-400' };
  if (s === 'partial') return { text: 'PARTIAL', bg: 'bg-amber-950 text-amber-400 border-amber-800', dot: 'bg-amber-400' };
  if (s === 'unsupported') return { text: 'BLOCKED', bg: 'bg-rose-950 text-rose-400 border-rose-800', dot: 'bg-rose-400' };
  return { text: 'UNTESTED', bg: 'bg-slate-900 text-slate-400 border-slate-700', dot: 'bg-slate-500' };
};
---

<div class="bg-slate-950 text-slate-100 rounded-2xl p-5 sm:p-6 border border-slate-800 shadow-xl my-6">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800 text-xs">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span class="font-bold text-slate-200 tracking-wide font-mono uppercase">
        Service Availability Matrix // {brandName}
      </span>
    </div>
    <span class="text-slate-400 font-mono text-[11px]">测试基准节点: {testNode}</span>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 my-4">
    {items.map((it) => {
      const badge = statusBadge(it.status);
      return (
        <div class="p-3.5 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col justify-between">
          <div class="flex items-start justify-between gap-2 mb-2">
            <div>
              <span class="text-[10px] font-mono text-slate-400 uppercase block">{it.type}</span>
              <h5 class="text-sm font-bold text-slate-100 font-mono">{it.name}</h5>
            </div>
            <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-bold border ${badge.bg}`}>
              <span class={`w-1.5 h-1.5 rounded-full ${badge.dot}`}></span>
              {badge.text}
            </span>
          </div>
          <p class="text-xs text-slate-400 font-mono mt-1">{it.desc}</p>
        </div>
      );
    })}
  </div>

  <div class="pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between text-[11px] text-slate-400 font-mono">
    <span>测试工具: RegionRestrictionCheck & 流媒体检测脚本</span>
    <span>实际解锁状态可能随流媒体IP风控策略变动而变化</span>
  </div>
</div>
