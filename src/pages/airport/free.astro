          </a>
        </div>

        <!-- Sibling Subtopics Navigation -->
        <div class="bg-white rounded-2xl border border-surface-border p-6 shadow-sm">
          <h4 class="text-base font-bold text-slate-900 mb-3 flex items-center gap-2">
            <span class="w-1.5 h-4 bg-brand-600 rounded-full"></span>
            机场推荐 关联精选专题
          </h4>
          <div class="space-y-1.5 text-xs">
            
            <a href="/airport/recommend/" class="block p-2 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-brand-600 font-medium">
              &bull; 机场推荐 指南
            </a>
            <a href="/airport/ranking/" class="block p-2 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-brand-600 font-medium">
              &bull; 机场排行 指南
            </a>
            <a href="/airport/cost-effective/" class="block p-2 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-brand-600 font-medium">
              &bull; 性价比机场 指南
            </a>
            <a href="/airport/stable/" class="block p-2 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-brand-600 font-medium">
