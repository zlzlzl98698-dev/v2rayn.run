  author: {
    '@type': 'Organization',
    name: 'v2rayn指南测评实验室',
    url: 'https://v2rayn.run/'
  },
  publisher: {
    '@type': 'Organization',
    name: 'v2rayn指南',
    logo: {
      '@type': 'ImageObject',
      url: 'https://v2rayn.run/favicon.webp'
    }
  },
  datePublished: '2026-10-26T08:00:00+08:00',
  dateModified: '2026-11-18T18:50:00+08:00',
  mainEntityOfPage: 'https://v2rayn.run/resources/beginner/'
